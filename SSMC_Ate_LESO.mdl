<?xml version="1.0" encoding="utf-8"?>
<chart id="25">
  <P Name="name">MATLAB Function1</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">25</P>
  <P Name="ssIdHighWaterMark">23</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">control</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">25</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [U, tau,et,vx,vz] = control(err, planta,z3e, x3e, Iet)

    m = 1; g = 9.81;
    kth = 100; kom =50;

    k=4;%4
    m=1;%1
    l=1;%2
    n=1;%1

    ex  = err(1);
    dex = err(2);
    Iex = err(3);   
    ez  = err(4);
    dez = err(5);
    Iez = err(6);

    x     = planta(1);
    dx    = planta(2);
    z     = planta(3);
    dz  = planta(4);
    th    = planta(5);
    thdot = planta(6);

    Kz=10;
    mz = 20;

    sz = dez + mz*ez;
    vz = (-z3e + mz*dez + Kz*sign(sz));

    Kx=0.1;
    mx = 10;

    sx = dex + mx*ex;
    vx = (-x3e + mx*dex + Kx*sign(sx));

    U   = m*sqrt(vx^2 + (vz+g)^2);
    thd = atan2(-vx, vz+g);

    et = th - thd;
    det = thdot;

    Ka = 2;         %3
    La = -50;      %-100
    na = 10;        %10

    Vet = La + na*abs(det) + na*abs(et);
    st   = det + na*et + na*Iet;
    tau  = + Ka*Vet*sign(st);

    %st = det + na*et;
    %tau = -na*et + Ka*sat(st);
end



function y = sat(u)
if u &gt; 1
    y = 1;
elseif u &lt; -1
    y = -1;
else
    y = u;
end
end</P>
      </eml>
    </state>
    <data SSID="4" name="err">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
