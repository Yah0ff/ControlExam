__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_22.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="22">
  <P Name="name">MATLAB Function1</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">22</P>
  <P Name="ssIdHighWaterMark">20</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">control</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">22</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [U, tau,et,thd,vx,vx2] = control(err, planta,Iet,dth)

p = 1; g = 9.81;

K_int = [948.9915 , 40.2834 , 6898.4127]; 
K_x = [17.1814  5.3696  15.6621];   
K_z = K_x;                         

ex  = err(1);
dex = err(2);
Iex = err(3);   
ez  = err(4);
dez = err(5);
Iez = err(6);
xrdd = err(7);
zrdd = err(8);

x     = planta(1);
dx    = planta(2);
z     = planta(3);
dz  = planta(4);
th    = planta(5);
dt = planta(6);

vx = K_x(1)*ex + K_x(2)*dex + K_x(3)*Iex;
vz = K_z(1)*ez + K_z(2)*dez + K_z(3)*Iez;

k=2;%4
m=1;%1
l=2;%2
n=1;%1

sx = dex + n*ex;
vx2 = -n*ex + l*sign(sx);

sz = dez + m*ez;
%vz = -m*ez + k*sign(sz);


U   = p*sqrt(vx^2 + (vz+g)^2);
thd = atan2(-vx, vz+g);

det = dt;

% Lazo interno con LMI
et  = th - thd;
tau = -K_int(1)*et - K_int(2)*det - K_int(3)*Iet;

e = th - thd;
de = dt;

j = 200;
b = 10;

s = de +  b*e;
%tau = - b*de - j*sign(s);

end



function y = sat(u)
if u &gt; 1
    y = 1;
elseif u &lt; -1
    y = -1;
else
    y = u;
end
end</P>
      </eml>
    </state>
    <data SSID="4" name="err">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
